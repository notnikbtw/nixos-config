@import "~/.config/themes/current/colors.rasi"
@import "~/.config/rofi/font.rasi"

* {
    background-color: transparent;
    text-color: @fg1;
    foreground: @fg1;
    normal-foreground: @fg1;
}

window {
    background-color: @bg0;
    border: 2px;
    border-color: @accent;
    border-radius: 0px;
    width: 480px;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg1;
    border-radius: 0px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @gray;
    text-color: @fg1;
    cursor: text;
}

listview {
    lines:     8;
    spacing:   4px;
    scrollbar: false;
}

element {
    padding: 6px 10px;
    border-radius: 0px;
    background-color: transparent;
    text-color: @fg1;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg1;
}

element normal.urgent {
    background-color: @bg0;
    text-color: @orange;
}

element normal.active {
    background-color: @bg0;
    text-color: @accent;
}

element selected.normal {
    background-color: @bg1;
    text-color: @accent;
}

element selected.urgent {
    background-color: @bg1;
    text-color: @orange;
}

element selected.active {
    background-color: @bg1;
    text-color: @accent;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg1;
}

element alternate.urgent {
    background-color: @bg0;
    text-color: @orange;
}

element alternate.active {
    background-color: @bg0;
    text-color: @accent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
}

element-icon {
    background-color: transparent;
    size: 20px;
    margin: 0 8px 0 0;
    cursor: inherit;
}
