* {
    bg0: #282828;
    bg1: #3c3836;
    fg1: #ebdbb2;
    fg2: #d5c4a1;
    yellow: #fabd2f;
    orange: #fe8019;
    gray: #928374;

    background-color: transparent;
    text-color: @fg1;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg0;
    border: 2px;
    border-color: @orange;
    border-radius: 1px;
    width: 480px;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg1;
    border-radius: 1px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @yellow;
}

entry {
    placeholder: "Search...";
    placeholder-color: @gray;
}

listview {
    lines:     8;
    spacing:   4px;
    scrollbar: false;
}

element {
    padding: 6px 10px;
    border-radius: 1px;
    background-color: transparent;
}

element selected {
    background-color: @bg1;
    text-color: @yellow;
}

element-text {
    vertical-align: 0.5;
}
