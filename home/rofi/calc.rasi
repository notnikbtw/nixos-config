@import "~/.config/themes/current/colors.rasi"
@import "~/.config/rofi/font.rasi"

* {
    background-color: transparent;
    text-color: @fg1;
}

window {
    background-color: @bg0;
    border: 2px;
    border-color: @accent;
    border-radius: 0px;
    width: 480px;
    padding: 14px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, message ];
    spacing: 10px;
}

inputbar {
    background-color: @bg1;
    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "2+2, 5 km to mi, sqrt(16)...";
    placeholder-color: @gray;
    text-color: @fg1;
}

message {
    background-color: @bg1;
    padding: 8px 12px;
}

textbox {
    text-color: @accent;
}
